{
  "name": "42-tt-ladder",
  "version": "0.3.0",
  "private": true,
  "description": "Table tennis rating ladder and tournaments for 42 students",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "test": "node --test test/*.test.js",
    "setup:live": "node scripts/setup-live.js",
    "release": "node --disable-warning=ExperimentalWarning scripts/release.js",
    "live": "node --disable-warning=ExperimentalWarning scripts/live.js",
    "rollback": "node scripts/rollback.js",
    "backup:live": "node --disable-warning=ExperimentalWarning scripts/backup.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.0"
  }
}
