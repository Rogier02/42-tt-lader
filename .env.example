# Copy to .env and fill in. With no FT_CLIENT_ID the app runs in dev mode
# (simulated sign-in, demo data). Never commit your real .env.

PORT=3000
# The public address people use. Must match the redirect URI registered at 42.
BASE_URL=http://localhost:3000
# Use 0.0.0.0 when running on a server or in Docker.
HOST=127.0.0.1

# 42 intra app (profile.intra.42.fr > API > Register a new app)
# Redirect URI to register: <BASE_URL>/auth/42/callback
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Long random string. Generate one with: openssl rand -hex 32
COOKIE_SECRET=

# Optional: only let students of these campus ids sign in (comma separated).
ALLOWED_CAMPUS_IDS=
# Optional: 42 logins that get admin rights (comma separated).
ADMIN_LOGINS=

# Only used to create the very first season. After that, admins end a season and
# start the next one from the Coalitions page. Ratings carry over between seasons.
SEASON_NAME=Autumn 2026
SEASON_START=2026-09-01
AUTO_CONFIRM_HOURS=24

# New tournaments need approval from an admin (ADMIN_LOGINS) before they appear.
REQUIRE_TOURNAMENT_APPROVAL=true
# Coalition names. Members' coalitions come from the 42 API; anyone without one
# gets a random coalition (balanced). Rules for the coalition race: server/standings.js
COALITIONS=Vela,Cetus,Pyxis

# "A challenger approaches": every Monday 08:00 each player gets a random opponent within 150 rating.
# Those matches count 3x for season and coalition points. Set to false to switch it off.
CHALLENGERS=true
# Time zone for the Monday draw and dates.
TZ=Europe/Amsterdam
